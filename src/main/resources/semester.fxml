<?xml version="1.0" encoding="UTF-8"?>

<!--
  Semesters - a tab inside AcademicPage. See classroom.fxml for why the in-file
  heading and the inline styles were removed.
-->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fras.controller.SemesterController">
    <center>
        <VBox spacing="16">

            <VBox spacing="16" styleClass="panel">
                <Label text="Add or edit a semester" styleClass="panel-title"/>

                <GridPane hgap="12" vgap="10">
                    <Label text="Department" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="comboDepartment" prefWidth="260"
                              promptText="which department"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Name" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtSemesterName" prefWidth="260"
                               promptText="e.g. Autumn 2026"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Number" styleClass="field-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtSemesterNumber" prefWidth="260"
                               promptText="e.g. 3"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <HBox spacing="8">
                    <Button text="Add" fx:id="btnAdd" onAction="#addSemester"
                            styleClass="button-primary"/>
                    <Button text="Update" fx:id="btnUpdate" onAction="#updateSemester"/>
                    <Button text="Delete" fx:id="btnDelete" onAction="#deleteSemester"
                            styleClass="button-danger"/>
                    <Button text="Clear" fx:id="btnClear" onAction="#clearForm"
                            styleClass="button-ghost"/>
                </HBox>
            </VBox>

            <TableView fx:id="semesterTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="55"/>
                    <TableColumn fx:id="colName" text="Semester" prefWidth="180"/>
                    <TableColumn fx:id="colNumber" text="Number" prefWidth="90"/>
                    <TableColumn fx:id="colDepartment" text="Department" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
